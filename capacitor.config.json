{
  "appId": "com.pulsemessenger.app",
  "appName": "Pulse Messenger",
  "webDir": "public",
  "bundledWebRuntime": false,
  "server": {
    "cleartext": true
  },
  "android": {
    "allowMixedContent": true
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "Camera": {
      "permissions": ["camera", "photos"]
    }
  }
}
